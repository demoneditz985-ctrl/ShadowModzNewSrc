<?xml version="1.0" encoding="utf-8"?>
<!-- SHADOW MODZ - injector dashboard (unlocked by the activation key) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingTop="52dp"
        android:paddingBottom="32dp">

        <!-- tapping the logo opens the login page again (see MainActivity) -->
        <ImageView
            android:id="@+id/logo"
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.22"
            android:text="SHADOW MODZ"
            android:textColor="#A755F7"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="v5.0 PREMIUM EDITION  •  DEFAULT.CFG"
            android:textColor="#CFC7E6"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/logoHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.8"
            android:text="TAP THE LOGO TO RE-ENTER YOUR KEY"
            android:textColor="#CB98FE"
            android:textSize="11sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="#33A755F7" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_key_field"
            android:gravity="center"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="READY"
            android:textColor="#CB98FE"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/actionButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_button_primary"
            android:letterSpacing="0.10"
            android:text="INJECT &amp; LAUNCH"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0.65"
            android:gravity="center"
            android:text="root: /dev/libmasgik.so  •  payload libmasgik.so&#10;no-root: virtual inject via libinject.so"
            android:textColor="#9A93B5"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/telegram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:text="TELEGRAM  t.me/+BBimnHMiSvpiYTBl"
            android:textColor="#A755F7"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
