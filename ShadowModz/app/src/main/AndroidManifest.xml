<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
	package="com.shadowmodz">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:supportsRtl="true">
        <!-- activation gate: launched first, unlocks the injector -->
        <activity
            android:name="com.shadowmodz.support.LoginActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/ShadowTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- injector dashboard: only reachable with a valid key -->
        <activity
            android:name="com.shadowmodz.support.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/ShadowTheme" />
    </application>
</manifest>
